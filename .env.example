# ==============================================================================
# CODIZ - Personal AI Coding Intelligence Platform
# Environment Variable Template (NEVER commit real secrets)
# ==============================================================================

# --- Server & Networking ---
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Security & Authentication ---
# Optional static API bearer token. If left blank, Codiz provides a first-run
# workspace passphrase setup UI hashed with scrypt on the server.
CODIZ_API_TOKEN=
CODIZ_WORKSPACE_ROOT="."

# --- Inference Provider Routing ---
# Modes: auto | local-ollama | vllm | gemini
# "auto" prefers local low-resource quantized inference when reachable,
# then Cloud Run vLLM, then server-side Gemini.
CODIZ_INFERENCE_MODE="auto"

# Local zero-cost open-weight quantized runtime (Ollama / llama.cpp)
LOCAL_LLM_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_LLM_MODEL="qwen3:4b-q4_K_M"
LOCAL_EMBED_MODEL="nomic-embed-text"

# Scale-to-zero Python vLLM inference service (Cloud Run GPU)
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL_ID="Qwen/Qwen3-4B-Instruct"

# --- AI Teacher & Evaluator ---
# GEMINI_API_KEY is injected by AI Studio or Secret Manager on the server.
GEMINI_API_KEY=
TEACHER_PROVIDER="gemini"
TEACHER_MODEL="gemini-4-hydrogen"
TEACHER_API_BASE_URL=
TEACHER_API_KEY=

# --- Google Cloud Storage (Artifact & Model Registry) ---
GCP_PROJECT_ID=
GCP_REGION="europe-west1"
GCS_BUCKET_NAME=
# In Cloud Run, use attached Service Account IAM instead of JSON key files.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Budget Management ($20/mo strict constraint) ---
MONTHLY_BUDGET_USD=20
PREFERRED_CURRENCY="KES"
MAX_DAILY_TEACHER_CALLS=100
MAX_REQUEST_TOKENS=4096
ENABLE_AUTO_PROMOTION="false"
MIN_DATASET_EXAMPLES_FOR_TRAINING=25
